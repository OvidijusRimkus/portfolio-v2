// backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * Admin modelis.
 *
 * Registracijos nebus.
 * Admin vartotoją vėliau sukursime per seed failą iš .env:
 * - ADMIN_USERNAME
 * - ADMIN_PASSWORD
 */
model Admin {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admins")
}

/**
 * ContactMessage modelis saugo žinutes iš portfolio kontaktų formos.
 */
model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contact_messages")
}

/**
 * AnalyticsEvent modelis saugo portfolio įvykius:
 * - page_view
 * - cv_download
 * - contact_submit
 *
 * Vėliau galėsime pridėti:
 * - country
 * - device
 * - browser
 * - OS
 * - session duration
 */
model AnalyticsEvent {
  id        String   @id @default(uuid())
  type      String
  path      String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([type])
  @@index([createdAt])
  @@map("analytics_events")
}