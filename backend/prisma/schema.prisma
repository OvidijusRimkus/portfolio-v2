// backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * Admin modelis.
 *
 * Registracijos nebus.
 * Admin vartotoją vėliau sukursime per seed failą iš .env:
 * - ADMIN_USERNAME
 * - ADMIN_PASSWORD
 */
model Admin {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admins")
}